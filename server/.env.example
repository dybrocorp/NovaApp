# NovaApp realtime server — configuration example.
# Copy to .env and fill in. NEVER commit a real .env.

# HTTP port (healthz + admin API) and bind host.
PORT=4000

# Socket.IO endpoint path (must match the client).
SOCKET_PATH=/socket.io/

# engine.io liveness (client watchdog expects silence < 75s).
PING_INTERVAL=25000
PING_TIMEOUT=20000

# Hard cap on packet size (bytes) and on E2EE envelope ciphertext size
# (base64 chars ~= 64 KiB decoded). Small envelopes: they are E2EE blobs.
MAX_HTTP_BUFFER_SIZE=1000000
MAX_CIPHERTEXT_BASE64_CHARS=87384

# Web client origin allowlist (comma-separated; the mobile app has no CORS).
CORS_ORIGIN=*

# Bearer token for /admin/* endpoints. REQUIRED in production.
ADMIN_TOKEN=

# Handshake: challenge TTL, attempts per connection, failure lockout.
CHALLENGE_TTL_MS=60000
MAX_AUTH_ATTEMPTS_PER_CONNECTION=3
AUTH_FAILURES_LOCKOUT=5
AUTH_LOCKOUT_MS=120000
AUTH_LOCKOUT_SCOPES=device,ip

# Session TTL (sliding renewal on activity).
SESSION_TTL_MS=86400000

# Rate limits (per socket, per minute) — mirror of client presets.
AUTH_PER_MINUTE=5
MESSAGE_PER_MINUTE=30
TYPING_PER_MINUTE=12
SIGNALING_PER_MINUTE=60
SYNC_PER_MINUTE=6
PRESENCE_PER_MINUTE=12
TOTAL_EVENTS_PER_MINUTE=120
NEW_CONNECTIONS_PER_IP_PER_MINUTE=60

# Sync pagination (events per sync.response).
SYNC_PAGE_LIMIT=100

# Store backend: 'memory' (single node) or 'supabase' (source of truth).
STORE_BACKEND=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
